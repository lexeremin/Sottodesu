    "Everything goes back to where it was. Items you’ve since moved or deleted are skipped." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout retourne à son emplacement d’origine. Les éléments que vous avez déplacés ou supprimés depuis sont ignorés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての項目が元の場所に戻ります。その後に移動または削除した項目はスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 항목이 원래 위치로 돌아가요. 이후에 이동하거나 삭제한 항목은 건너뛰어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё вернётся на прежние места. Элементы, которые вы с тех пор переместили или удалили, будут пропущены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有项目都会回到原来的位置。之后被你移动或删除的项目将被跳过。"
          }
        }
      }
    },
