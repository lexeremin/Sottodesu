<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.sottodesu.app.scheduler</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>dev.sottodesu.app</string>
    </array>
    <!-- Not used any more: kept only so a test version's registration can be removed. Starts the app the normal way (through Launch Services) as a hidden, new instance. macOS refuses
         to let launchd start an ad-hoc signed app's executable directly. The app notices the run-schedules argument,
         sorts what is due and quits before any window or Dock icon appears. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-n</string>
        <string>-g</string>
        <string>-j</string>
        <string>-a</string>
        <string>/Applications/Sottodesu.app</string>
        <string>--args</string>
        <string>--run-schedules</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
